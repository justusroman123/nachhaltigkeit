# GPU-Image fuer den Server (Geruest). Nicht gebaut/getestet in Etappe 1.
# BASE_IMAGE bewusst ohne Standardwert: Der passende CUDA-Tag haengt vom Treiber des
# gemieteten Servers ab (unbekannt). Tag vor dem Bauen pruefen und uebergeben, z. B.
#   docker build -f docker/Dockerfile.gpu --build-arg BASE_IMAGE=<geprueftes-cuda-image> .
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --create-home --uid 10001 app

WORKDIR /app
COPY server/requirements.txt /app/requirements.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -r /app/requirements.txt
# Piper (Sprachausgabe, GPL-3.0; Entscheidung E10 offen). Entfernen, falls die Lizenzpruefung dagegen ausfaellt.
COPY server/requirements-tts.txt /app/requirements-tts.txt
RUN /opt/venv/bin/pip install -r /app/requirements-tts.txt
# Spracherkennung (faster-whisper, MIT) und Uebersetzung (Transformers/PyTorch). CUDA-Version von PyTorch muss zum
# Treiber des gemieteten Servers passen (unbekannt): vor dem Bauen pruefen, sonst requirements-mt.txt anpassen.
COPY server/requirements-asr.txt server/requirements-mt.txt /app/
RUN /opt/venv/bin/pip install -r /app/requirements-asr.txt -r /app/requirements-mt.txt
# Hinweis: Dieser Docker-Weg ist NICHT gebaut und NICHT getestet; die produktive VM laeuft ohne Docker (systemd). Modell-Abhaengigkeiten stehen in requirements-asr/-mt/-tts.txt.
#       und Lizenzpruefung (docs/entscheidungen.md) in eine eigene requirements-gpu.txt aufnehmen.
#       Modellgewichte NICHT ins Image backen und nicht im Repo ablegen; Volume nur lesend einbinden.

COPY server/app /app/app
COPY web /app/web
ENV PATH=/opt/venv/bin:$PATH WEB_DIR=/app/web HOST=0.0.0.0 PORT=8000
USER app
EXPOSE 8000
# Sichere Voreinstellungen (kein Zugriffslog, keine Adressen im Log, kleine Frames): siehe server/app/__main__.py.
# Hinter einem Proxy im Docker-Netz: TRUSTED_PROXIES auf das Netz des Proxys setzen (docker/docker-compose.yml).
CMD ["python", "-m", "app"]
