# Beispielwerte, KEINE Geheimnisse. Kopie als .env anlegen (wird nie eingecheckt).
# Echte Werte nur in der Umgebung bzw. lokalen .env setzen.
# WICHTIG: Die aktiven Zeilen hier sind die STANDARDWERTE des Programms (server/app/config.py). Ein Test (test_config.py) prueft das.
# Wer einen Wert aendert, tut das bewusst; alte Beispielwerte (z. B. kurze Satzgrenzen) wuerden sonst still Saetze abschneiden.

# --- Zugang ---
# Pflicht, mindestens 16 Zeichen und mindestens 8 verschiedene Zeichen. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
OPERATOR_KEY=

# --- Demo ohne Bedienschluessel (nur Prototyp auf dem eigenen Rechner) ---
# Mit ALLOW_NO_KEY=true und leerem OPERATOR_KEY braucht der Bedienplatz keinen Schluessel.
# Erlaubt nur mit HOST=127.0.0.1; nie auf einem Server im Internet verwenden. Dann werden nur Host-Namen dieses Rechners bedient (HOST_CHECK).
ALLOW_NO_KEY=false
HOST_CHECK=true

# --- Server ---
# Start immer mit "python -m app" (im Ordner server/): sichere Voreinstellungen, keine Adressen im Log.
HOST=127.0.0.1
PORT=8000
WEB_DIR=../web
# Optional: Adresse fuer Zuhoerer-Links und QR-Code, z. B. https://dolmetscher.example.org
# Leer = Adresse, unter der der Bedienplatz gerade geoeffnet ist.
PUBLIC_URL=
# WebSocket-Herkunftspruefung (Standard an). Nur fuer Vorschau-Tests hinter einem Zwischenserver auf "false" setzen:
ORIGIN_CHECK=true
# Nur von diesen Adressen/Netzen (kommagetrennt) wird X-Forwarded-For geglaubt (Reverse Proxy auf demselben Rechner = Loopback).
# Proxy in einem anderen Container/Netz: dessen Netz eintragen, sonst teilen alle Besucher eine Absender-Kennung.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Zugriffsschutz: Sperre nach falschen Bedienschluesseln je Absender (Annahmen) ---
AUTH_MAX_FAILS=10
AUTH_WINDOW_S=600.0
AUTH_BLOCK_S=900.0

# --- Pipeline-Stufen: mock | real ---
ASR_BACKEND=mock
MT_BACKEND=mock
TTS_BACKEND=mock
TTS_ENABLED=true

# --- Sprachen (Quelle ist immer Deutsch) ---
# uk=Ukrainisch ar=Arabisch en=Englisch tr=Tuerkisch fa=Persisch (optional)
# Waehlbar am Bedienplatz:
TARGET_LANGS=uk,ar,en,tr,fa
# Vorab angehakt (Teilmenge von TARGET_LANGS; leer lassen = alle ausser Persisch):
DEFAULT_LANGS=uk,ar,en,tr

# --- Zuhoerer-Links und Raeume (Sekunden) ---
LISTENER_TTL_S=3600
MIN_LISTENER_TTL_S=60
MAX_LISTENER_TTL_S=28800
ROOM_TTL_S=43200
# Raum ohne verbundenen Bedienplatz wird nach dieser Zeit geschlossen (Links, Verlauf und Warteschlangen sind dann weg; Annahme):
ROOM_IDLE_S=3600.0
# Obergrenzen (Annahmen):
MAX_ROOMS=20
MAX_TOKENS_PER_ROOM=200
MAX_LISTENERS_PER_ROOM=100
# Gespraechsmodus: so viele Gaeste gleichzeitig
MAX_GUESTS=3
# Letzte Untertitel (nur Text) fuer Zuhoerer, die spaeter beitreten (0 = aus), und wie lange sie hoechstens gehalten werden (Sekunden):
RING_BUFFER_SIZE=40
HISTORY_S=120.0

# --- Gespraechsmodus: Sperre und Zeitgrenzen (alles Annahmen, im Test messen) ---
# 0 = aus (Standard): Eine Aussage endet nur durch "Fertig" oder den Stopp des Mitarbeiters, auch nach langen Pausen.
# Wert 10 bis 3600: so viele Sekunden ohne hoerbare Sprache, dann endet die Aussage von selbst (Redezeit selbst ist nie begrenzt):
TURN_IDLE_S=0.0
# Automatisch uebergebene Wortmeldung: so lange auf die Bestaetigung warten:
TURN_PICKUP_S=30.0
# Laengste Verarbeitung nach einer Aussage, dann geht es weiter:
TURN_PROCESS_MAX_S=90.0
# Mindest-Wartezeit auf "fertig" der Geraete (dazu kommt die Laenge des Tons) und kurze Schonfrist danach:
TURN_PLAY_MAX_S=15.0
TURN_GRACE_S=0.5

# --- Segmentierung und Rueckstau ---
# Hoechstens so viele Woerter je Uebersetzung (Saetze werden am Satzende getrennt):
SEGMENT_MAX_WORDS=40
# Rest ohne Satzzeichen so lange auf die Fortsetzung warten, dann trotzdem uebersetzen (ms, 0 = sofort):
SEGMENT_TAIL_HOLD_MS=2200
# Eine Uebersetzungs-/Sprachstufe laenger als das: Satz als Problem melden (Sekunden):
STAGE_TIMEOUT_S=60.0
# Warteschlange je Sprache; darueber werden aelteste Segmente verworfen (Vollstaendigkeit geht vor):
LANG_QUEUE_MAX=500
# Ab so vielen wartenden Segmenten einer Sprache entfaellt der Ton, Untertitel bleiben (praktisch aus):
TTS_SKIP_BACKLOG=100000

# --- Kosten-Anzeige am Bedienplatz (optional, 0 = aus). Netto je Stunde ohne Zuschlaege, Budget in Euro ---
SERVER_HOURLY_EUR=0.0
BUDGET_EUR=0.0

# --- Mock-Verhalten ---
MOCK_ASR_SEGMENT_S=2.0
MOCK_DELAY_MS=0

# --- Echte Stufen (alle Werte unbekannt/zu klaeren, siehe docs/entscheidungen.md) ---
# Modell: Ordner (Betrieb: lokal, dann werden Telemetrie und Internet-Zugriffe der Bibliotheken abgeschaltet) oder Name (laedt aus dem Internet)
ASR_MODEL=large-v3
# Spracherkennung (faster-whisper): Geraet und Rechengenauigkeit; Pausen-Schwellen sind ANNAHMEN, an echten Aufnahmen messen
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=default
ASR_BEAM_SIZE=5
ASR_SILENCE_MS=800
ASR_MAX_UTTERANCE_S=8.0
ASR_MIN_SPEECH_MS=300
ASR_VAD_RMS=400
# Uebersetzung (Transformers): Ordner oder Modell-ID des Modells (unbekannt, nicht geraten)
MT_MODEL_ID=
MT_DEVICE=auto
MT_DTYPE=auto
MT_MAX_NEW_TOKENS=1024
# structured = Quell-/Zielsprache als Felder im Chat-Format (laut Modellkarte von TranslateGemma, Standard)
# plain = Plan-Prompt als Text (nur zum Vergleich: scripts/quality_run.py --modes structured,plain)
MT_PROMPT_MODE=structured
# Sprachcodes: Standard ist der eigene Code (z. B. uk). Falls das Modell einen Code ablehnt: z. B. MT_LANG_CODES=ar=ar-SA,uk=uk-UA
MT_LANG_CODES=
TTS_VOICE_DIR=
# Stimme je Sprache (Piper): sprache=stimme[:sprecher], kommagetrennt; Dateien <TTS_VOICE_DIR>/<stimme>.onnx
# Sprache ohne Eintrag: nur Untertitel. Beispiel (Lizenz je Stimme vorher pruefen; "de" = Vorlesung der Gast-Antworten fuer den Mitarbeiter):
# TTS_VOICES=uk=uk_UA-ukrainian_tts-medium:0,en=en_GB-alba-medium,de=de_DE-thorsten-medium
TTS_VOICES=
# Fehlersuche mit Testinhalten: Fehlermeldungen (gekuerzt) mitloggen; kann Textteile enthalten, im Betrieb auf false lassen
DEBUG_FEHLER=false
# Nur falls das Modell-Repository Anmeldung verlangt; Token nie ins Repo:
HF_TOKEN=
