# Beispielwerte, KEINE Geheimnisse. Kopie als .env anlegen (wird nie eingecheckt).
# Echte Werte nur in der Umgebung bzw. lokalen .env setzen.

# --- Zugang ---
# Pflicht, mindestens 16 Zeichen. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
OPERATOR_KEY=

# --- Demo ohne Bedienschluessel (nur Prototyp auf dem eigenen Rechner) ---
# Mit ALLOW_NO_KEY=true und leerem OPERATOR_KEY braucht der Bedienplatz keinen Schluessel.
# Erlaubt nur mit HOST=127.0.0.1; nie auf einem Server im Internet verwenden.
ALLOW_NO_KEY=false

# --- Server ---
HOST=127.0.0.1
PORT=8000
WEB_DIR=../web
# Optional: Adresse fuer Zuhoerer-Links und QR-Code, z. B. https://dolmetscher.example.org
# Leer = Adresse, unter der der Bedienplatz gerade geoeffnet ist.
PUBLIC_URL=
# WebSocket-Herkunftspruefung (Standard an). Nur fuer Vorschau-Tests hinter einem Zwischenserver auf "false" setzen:
ORIGIN_CHECK=true

# --- Pipeline-Stufen: mock | real ---
ASR_BACKEND=mock
MT_BACKEND=mock
TTS_BACKEND=mock
TTS_ENABLED=true

# --- Sprachen (Quelle ist immer Deutsch) ---
# uk=Ukrainisch ar=Arabisch en=Englisch tr=Tuerkisch fa=Persisch (optional)
# Waehlbar am Bedienplatz:
TARGET_LANGS=uk,ar,en,tr,fa
# Vorab angehakt (Teilmenge von TARGET_LANGS; leer lassen = alle ausser Persisch):
DEFAULT_LANGS=uk,ar,en,tr

# --- Zuhoerer-Links und Raeume (Sekunden) ---
LISTENER_TTL_S=3600
MIN_LISTENER_TTL_S=60
MAX_LISTENER_TTL_S=28800
ROOM_TTL_S=43200
# Platzhalter, nicht gemessen:
MAX_LISTENERS_PER_ROOM=100
# Anzahl der letzten Untertitel fuer Zuhoerer, die spaeter beitreten (0 = aus)
RING_BUFFER_SIZE=5

# --- Segmentierung und Rueckstau ---
# Hoechstens so viele Woerter je Uebersetzung (sonst Schnitt, bevorzugt an Komma):
SEGMENT_MAX_WORDS=12
# Warteschlange je Sprache; darueber werden aelteste Segmente verworfen:
LANG_QUEUE_MAX=8
# Ab so vielen wartenden Segmenten einer Sprache entfaellt der Ton, Untertitel bleiben:
TTS_SKIP_BACKLOG=2

# --- Kosten-Anzeige am Bedienplatz (optional, 0 = aus). Netto je Stunde ohne Zuschlaege, Budget in Euro ---
SERVER_HOURLY_EUR=0
BUDGET_EUR=0

# --- Mock-Verhalten ---
MOCK_ASR_SEGMENT_S=2.0
MOCK_DELAY_MS=0

# --- Echte Stufen (alle Werte unbekannt/zu klaeren, siehe docs/entscheidungen.md) ---
ASR_MODEL=large-v3
# Spracherkennung (faster-whisper): Geraet und Rechengenauigkeit; Pausen-Schwellen sind ANNAHMEN, an echten Aufnahmen messen
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=default
ASR_BEAM_SIZE=5
ASR_SILENCE_MS=700
ASR_MAX_UTTERANCE_S=12
ASR_MIN_SPEECH_MS=300
ASR_VAD_RMS=400
# Uebersetzung (Transformers): Ordner oder Modell-ID des Modells (unbekannt, nicht geraten)
MT_MODEL_ID=
MT_DEVICE=auto
MT_DTYPE=auto
MT_MAX_NEW_TOKENS=256
# plain = Plan-Prompt als Text (Standard). structured = Quell-/Zielsprache als Felder im Chat-Format; ob TranslateGemma das
# so erwartet, ist UNBEKANNT und wird auf dem Server verglichen (scripts/quality_run.py --modes plain,structured)
MT_PROMPT_MODE=plain
TTS_VOICE_DIR=
# Stimme je Sprache (Piper): sprache=stimme[:sprecher], kommagetrennt; Dateien <TTS_VOICE_DIR>/<stimme>.onnx
# Sprache ohne Eintrag: nur Untertitel. Beispiel (Lizenz je Stimme vorher pruefen):
# TTS_VOICES=uk=uk_UA-ukrainian_tts-medium:0,en=en_GB-alba-medium
TTS_VOICES=
# Nur falls das Modell-Repository Anmeldung verlangt; Token nie ins Repo:
HF_TOKEN=
