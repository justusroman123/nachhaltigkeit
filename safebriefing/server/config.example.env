# SafeBriefing Edge-Server – Beispielkonfiguration
#
# Verwendung:
#   cp server/config.example.env server/config.env
#   (dann config.env anpassen und mit "npm start" starten)
#
# Regeln:
#   - Eine Variable pro Zeile im Format KEY=VALUE; Zeilen mit # sind Kommentare.
#   - Werte dürfen in "..." oder '...' stehen.
#   - Echte Umgebungsvariablen haben IMMER Vorrang vor dieser Datei.
#   - config.env kann API-Schlüssel enthalten: nicht einchecken, nicht weitergeben.
#
# Datenschutz:
#   Der Server hält Briefings, Übersetzungen und Audio ausschließlich im
#   Arbeitsspeicher, schreibt nichts auf die Festplatte und protokolliert keine
#   Inhalte. Mit lokalen Diensten (LibreTranslate, Ollama, Whisper im Werksnetz)
#   verlassen keine Daten das Werk. Cloud-Dienste (DeepL, Mistral usw.) nur mit
#   Auftragsverarbeitungsvertrag und nach Abstimmung mit Datenschutz und
#   Betriebsrat einsetzen.

# --- Netzwerk ---------------------------------------------------------------

# 0.0.0.0 = auf allen Netzwerkkarten erreichbar (nötig für Smartphones/Tablets
# im Werks-WLAN). 127.0.0.1 = nur auf diesem Rechner.
HOST=0.0.0.0
PORT=8080

# --- Übersetzung ------------------------------------------------------------

# Engine für die Übersetzung:
#   none            keine Übersetzung (/api/translate antwortet mit 503)
#   mock            Schein-Übersetzung "[EN] Text" – NUR für Demos und Tests!
#   libretranslate  LibreTranslate-Server (Open Source, lokal betreibbar)
#   openai          OpenAI-kompatible Chat-API: Ollama, vLLM, LM Studio oder
#                   EU-Anbieter wie Mistral
#   deepl           DeepL API (Cloud – Texte verlassen das Werksnetz!)
TRANSLATE_ENGINE=none

# Engine für die Rückübersetzung (Prüfung). Leer = dieselbe wie TRANSLATE_ENGINE.
# Empfehlung: eine ANDERE Engine wählen. Dann prüft ein unabhängiges System,
# und systematische Fehler einer Engine werden nicht von ihr selbst "bestätigt".
BACK_ENGINE=

# Zeitlimit je Übersetzungsanfrage in Millisekunden.
TRANSLATE_TIMEOUT_MS=15000

# --- LibreTranslate -----------------------------------------------------------

# Basis-URL des LibreTranslate-Servers, z. B. nach
#   docker run -p 5000:5000 libretranslate/libretranslate
LIBRETRANSLATE_URL=http://localhost:5000
# Nur nötig, wenn der Server mit API-Schlüsseln betrieben wird.
LIBRETRANSLATE_API_KEY=

# --- OpenAI-kompatible Chat-API ----------------------------------------------

# Basis-URL einschließlich /v1, zum Beispiel:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
#   Mistral:    https://api.mistral.ai/v1   (Cloud, EU)
OPENAI_BASE_URL=http://localhost:11434/v1
# Modellname, wie ihn der Server erwartet (bei Ollama vorher "ollama pull <modell>").
OPENAI_MODEL=qwen2.5:7b-instruct
# Leer = kein Authorization-Header (lokale Server brauchen meist keinen Schlüssel).
OPENAI_API_KEY=

# --- DeepL (Cloud) -------------------------------------------------------------

# Free-Schlüssel (enden auf ":fx"): https://api-free.deepl.com
# Pro-Schlüssel:                     https://api.deepl.com
DEEPL_API_URL=https://api-free.deepl.com
DEEPL_API_KEY=
# Optionale DeepL-Glossare je Zielsprache als JSON-Objekt (gilt nur für
# Übersetzungen aus dem Deutschen), z. B.:
#   DEEPL_GLOSSARY_IDS={"en":"<glossar-id-en>","pl":"<glossar-id-pl>"}
DEEPL_GLOSSARY_IDS=

# --- Spracherkennung (Speech-to-Text) ----------------------------------------

# Vollständige URL eines OpenAI-kompatiblen Endpunkts /v1/audio/transcriptions.
# Leer = Spracheingabe deaktiviert (/api/stt antwortet mit 503). Beispiele:
#   speaches / faster-whisper-server:  http://localhost:8000/v1/audio/transcriptions
#   whisper.cpp-Server, gestartet mit --port 8081 --inference-path /v1/audio/transcriptions:
#                                      http://localhost:8081/v1/audio/transcriptions
STT_URL=
STT_MODEL=Systran/faster-whisper-small
# Gesprochene Sprache der Führungskraft (ISO-639-1).
STT_LANGUAGE=de
# Leer = kein Authorization-Header.
STT_API_KEY=
# Zeitlimit je Transkription in Millisekunden.
STT_TIMEOUT_MS=30000

# --- Browser-App -------------------------------------------------------------

# Verzeichnis mit der Browser-App (index.html). Leer = ../app neben dem server-Ordner.
STATIC_ROOT=
